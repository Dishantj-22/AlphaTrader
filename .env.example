# ─── Application ─────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production

# ─── Databases (microservices mode only) ─────────────────────
TIMESCALE_URL=postgresql+asyncpg://trader:trader@localhost:5432/alphatrader
POSTGRES_URL=postgresql+asyncpg://trader:trader@localhost:5432/alphatrader
MONGO_URI=mongodb://localhost:27017/alphatrader
REDIS_URL=redis://localhost:6379/0

# ─── Kafka (microservices mode only) ─────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ─── MLflow (model training only) ────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000

# ═════════════════════════════════════════════════════════════
#  DATA PROVIDERS  (all optional — yfinance is used by default)
#  Set only the ones you have. predict.py auto-selects the best
#  available provider at runtime.
# ═════════════════════════════════════════════════════════════

# ── Provider: yfinance (default, no key needed) ───────────────
# Just run: python predict.py --symbol RELIANCE
# Nothing to configure here.

# ── Provider: Zerodha Kite Connect ───────────────────────────
# Docs: https://kite.trade/docs/connect/v3/
# Get access token daily via: https://kite.trade/connect/login
ZERODHA_API_KEY=
ZERODHA_ACCESS_TOKEN=

# ── Provider: Upstox v2 ───────────────────────────────────────
# Docs: https://upstox.com/developer/api-documentation/
# Generate access token via OAuth2 flow in Upstox Developer Console
UPSTOX_ACCESS_TOKEN=

# ── Provider: Angel One Smart API ────────────────────────────
# Docs: https://smartapi.angelbroking.com/docs
# Requires TOTP app (Google Authenticator) linked to your account
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=

# ── Provider: Groww (unofficial internal API) ─────────────────
# ⚠️  Unofficial — may break if Groww updates their web app.
# How to get your token:
#   1. Open https://groww.in in Chrome
#   2. Log in to your Groww account
#   3. Open DevTools → Network tab → filter by "api"
#   4. Click any request to groww.in
#   5. Copy the value of the "Authorization" header (starts with "Bearer ")
#   6. Paste only the token part (without "Bearer ") below
GROWW_AUTH_TOKEN=
